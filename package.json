{
	"name": "pro-api-sdk",
	"version": "1.21.0",
	"description": "嘉立创EDA & EasyEDA 专业版扩展 API 开发工具",
	"author": "JLCEDA <support@lceda.cn>",
	"license": "Apache-2.0",
	"homepage": "https://pro.lceda.cn/",
	"scripts": {
		"compile": "rimraf ./dist/ && ts-node ./config/esbuild.prod.ts",
		"build:iframe": "node scripts/build-iframe.mjs",
		"watch:iframe": "node scripts/build-iframe.mjs --watch",
		"prepare": "husky",
		"prettier:all": "prettier --write .",
		"eslint:all": "eslint --ext .ts --fix .",
		"fix": "npm run prettier:all && npm run eslint:all",
		"build": "npm run build:iframe && npm run compile && ts-node ./build/packaged.ts",
		"pretest": "npm run check",
		"test": "node --test \"test/*.test.mjs\"",
		"test:samples": "node test/samples/run.mjs",
		"test:all": "npm test && node test/samples/run.mjs",
		"check:layout": "node tools/layout-check.mjs",
		"check:js": "node tools/check-js.mjs",
		"check:js:update": "node tools/check-js.mjs --update",
		"check:deps": "node tools/check-deps.mjs",
		"check": "npm run check:deps && npm run check:js",
		"bridge": "node tools/eda-bridge/server.mjs",
		"bridge:run": "node tools/eda-bridge/run.mjs",
		"sign": "node tools/apply-signature.mjs"
	},
	"devDependencies": {
		"@jlceda/pro-api-types": "^0.1.175",
		"@microsoft/tsdoc": "^0.15.1",
		"@trivago/prettier-plugin-sort-imports": "^5.2.1",
		"@types/fs-extra": "^11.0.4",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"esbuild": "^0.24.2",
		"eslint": "^8.57.0",
		"eslint-config-alloy": "^5.1.2",
		"eslint-plugin-tsdoc": "^0.4.0",
		"fs-extra": "^11.3.0",
		"husky": "^9.1.7",
		"ignore": "^7.0.3",
		"jszip": "^3.10.1",
		"lint-staged": "^15.3.0",
		"prettier": "^3.4.2",
		"rimraf": "^6.1.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3"
	},
	"lint-staged": {
		"*.ts": "eslint --cache --cache-location temp/.eslintcache --fix",
		"*.{js,ts,html,css,json,md}": "prettier --write"
	},
	"engines": {
		"node": ">=20.5.0"
	}
}
